# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://0.0.0.0:3000
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=LearnOS <noreply@learnos.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# PostgreSQL
POSTGRES_DB=learnos
POSTGRES_USER=learnos
POSTGRES_PASSWORD=learnos
DATABASE_URL=postgresql://learnos:learnos@db:5432/learnos

# AI (optional; without a key the app uses demo mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_MAX_UPLOAD_BYTES=26214400

# Redis and frontend
REDIS_URL=redis://redis:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Isolated execution (disabled unless both controller values are set)
EXECUTION_CONTROLLER_URL=
EXECUTION_CONTROLLER_SECRET=
EXECUTION_TIMEOUT_SECONDS=10
EXECUTION_MEMORY_MB=768
EXECUTION_CPU_MILLIS=500
EXECUTION_OUTPUT_BYTES=65536
STUDY_VIDEO_COMPLETION_PERCENT=90

# Razorpay billing. Use test-mode credentials locally and separate live secrets in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_URL=https://api.razorpay.com/v1
RAZORPAY_TIMEOUT_SECONDS=10

# Controller-to-sandbox provider connection. The controller never executes code locally.
SANDBOX_BACKEND=
DOCKER_GID=0
PYTHON_RUNNER_IMAGE=python:3.12-alpine
JAVASCRIPT_RUNNER_IMAGE=node:22-alpine
TYPESCRIPT_RUNNER_IMAGE=denoland/deno:alpine
JAVA_RUNNER_IMAGE=eclipse-temurin:21-jdk-alpine
C_RUNNER_IMAGE=gcc:14
CPP_RUNNER_IMAGE=gcc:14
GO_RUNNER_IMAGE=golang:1.24-alpine
RUST_RUNNER_IMAGE=rust:alpine
PHP_RUNNER_IMAGE=php:8.4-cli-alpine
RUBY_RUNNER_IMAGE=ruby:alpine
KOTLIN_RUNNER_IMAGE=learnos-kotlin-runner:2.1.20
SQL_RUNNER_IMAGE=python:3.12-alpine
SANDBOX_PROVIDER_URL=
SANDBOX_PROVIDER_TOKEN=
